{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "GpsPolling": {
    "IntervaloSegundos": 20,
    "TtlAtivoSegundos": 40,
    "CheckpointViagemSegundos": 60
  },

  "GpsSources": {
    "BusPrimarySource": "ZIRIX_DIRECT",
    "BrtPrimarySource": "BRT_CURRENT",
    "BusShadowSources": [ "DATARIO" ],
    "BrtShadowSources": [ "DATARIO" ]
  },

  "ViagemOutbox": {
    "BatchSize": 100,
    "DelayEntreBatchesMs": 250,
    "CleanupBatchSize": 1000,
    "CleanupMaxBatchesPerRun": 10,
    "CleanupIntervalMinutes": 10,
    "CleanupDelayBetweenBatchesMs": 100,
    "RetentionDays": 7
  },

  "EtaV2": {
    "Enabled": false,
    "ShadowEnabled": false,
    "CanaryPercent": 0,
    "SamplingSeconds": 15,
    "MinSpeedKmh": 3,
    "PendingExpirationMinutes": 60,
    "QueueCapacity": 5000,
    "BatchSize": 250,
    "BatchMaxDelayMs": 500,
    "PersistenceRetryDelayMs": 1000,
    "ShutdownDrainSeconds": 10,
    "ExpirationBatchSize": 5000,
    "PendingCountIntervalMinutes": 5
  },

  "PositionCorrection": {
    "Enabled": false,
    "ShadowEnabled": false,
    "ShadowSamplingPercent": 10,
    "PolicyVersion": "B3_ADAPTATIVO_v1",
    "MaxProjectionAgeSeconds": 120,
    "CausalWindowSeconds": 180,
    "MaxCausalSamples": 32,
    "StateTtlSeconds": 300,
    "StateBatchSize": 100,
    "StateConflictRetryCount": 1,
    "StateMaxPayloadBytes": 65536,
    "AdaptiveB1LimitSeconds": 15,
    "StopSpeedKmh": 3,
    "StopDisplacementMeters": 10,
    "StopConfirmationObservations": 2,
    "FutureTimestampToleranceSeconds": 5
  },

  "PositionCorrectionShadowPipeline": {
    "ChannelCapacity": 10000,
    "PublisherBatchSize": 100,
    "PublisherMaxWaitMilliseconds": 5,
    "WorkerBatchSize": 100,
    "ClaimIdleSeconds": 30,
    "MaxAttempts": 5,
    "MaxPayloadBytes": 65536,
    "RetentionEnabled": true,
    "RetentionIntervalMinutes": 5,
    "MetricsReportIntervalMinutes": 5,
    "MainStreamSafetyMarginMinutes": 60,
    "DeadLetterRetentionDays": 7,
    "TrimLimit": 100000,
    "MaxStreamEntries": 5000,
    "MaxDeadLetterEntries": 1000
  },

  "HistoricoStreamRetention": {
    "MainStreamSafetyMarginMinutes": 60,
    "DeadLetterRetentionDays": 7,
    "TrimLimit": 100000
  },

  "TelemetriaMlRetention": {
    "Enabled": true,
    "IntervalMinutes": 5,
    "MainStreamSafetyMarginMinutes": 60,
    "DeadLetterRetentionDays": 7,
    "TrimLimit": 100000,
    "MaxStreamEntries": 100000,
    "MaxDeadLetterEntries": 10000
  },

  "TelemetriaMlSampling": {
    "Enabled": false,
    "LinePercentage": 10,
    "BlockMinutes": 60,
    "Seed": "NOPONTO_ML_V1"
  },

  "GPS": {
    "API": {
      "BASE_URL": "https://dados.mobilidade.rio/gps/sppo"
    },
    "HTTP_TIMEOUT_SECONDS": 15,
    "HUB": {
      "ROUTE": "/hub/gps"
    }
  }
}
