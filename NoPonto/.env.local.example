# Local Docker infrastructure only. Do not put production hosts or credentials here.
# PostgreSQL and Redis service hosts/ports used by the API are fixed by
# docker-compose.override.yml as postgres:5432 and redis:6379.

POSTGRES_DB=noponto_local
POSTGRES_USER=noponto_local
POSTGRES_PASSWORD=local-development-only

# Ports exposed by the local containers to the Windows host.
POSTGRES_PORT=5432
REDIS_PORT=6380
# Matching PostGIS batch permanece opt-in. Ausente ou false usa o fluxo individual.
GPS_MATCHING_BATCH_ENABLED=false
